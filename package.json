{
  "name": "safe-state-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "eslint . && prettier --check . && tsc -b --noEmit",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:anvil": "vitest run --config vitest.anvil.config.ts",
    "rpcs:refresh": "tsx --tsconfig tsconfig.node.json scripts/refresh-rpcs.ts",
    "registry:build": "tsx --tsconfig tsconfig.node.json scripts/build-registry.ts",
    "brand:export": "tsx --tsconfig tsconfig.node.json scripts/brand-export.ts",
    "cli": "tsx --tsconfig tsconfig.node.json scripts/check.ts"
  },
  "dependencies": {
    "@ethereumjs/mpt": "10.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gnosis-guild/zodiac": "5.0.1",
    "@playwright/test": "1.64.0",
    "@safe-global/safe-deployments": "1.37.63",
    "@safe-global/safe-modules-deployments": "3.0.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.149.0"
  }
}
