// Cloudflare Workers with static assets only: no Worker script, so every request is served from `dist`.
// Pages ignores this file (no `pages_build_output_dir`), so the same repo can also be connected to Pages.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safe-state-check",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // The custom domain is the only production URL; pull request previews still get workers.dev Preview URLs.
  "routes": [{ "pattern": "proofoftech.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "send_metrics": false,
}
